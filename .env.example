# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/venusespor_db"

# ─── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# ─── Gizmo v3 API ─────────────────────────────────────────────
# Gizmo sunucusunun adresi (LAN'da http://192.168.1.x:8080 veya Cloudflare Tunnel URL'i)
GIZMO_API_URL="http://localhost:8080"

# Gizmo operator hesabı (admin panel'de tanımlı)
GIZMO_USERNAME="admin"
GIZMO_PASSWORD="your-gizmo-password"

# ─── Cron Poller ──────────────────────────────────────────────
# Bu secret ile /api/cron/gizmo-sync çağrılır. Cron servisi (Vercel/Netlify)
# isteği Authorization: Bearer <secret> ile gönderir.
CRON_SECRET="generate-a-random-32-char-string"

# ─── İkas E-Ticaret ───────────────────────────────────────────
IKAS_API_URL="https://api.myikas.com/api/v1"
IKAS_API_KEY="your-ikas-api-key"
IKAS_STORE_ID="your-ikas-store-id"
IKAS_WEBHOOK_SECRET="your-ikas-webhook-secret"
