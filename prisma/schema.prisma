}

model GizmoProfile {
  id          String    @id @default(cuid())
  playerId        String    @unique
  player          Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Gizmo User Info
  gizmoUserId     Int       @unique  // Gizmo system user ID
  username        String    @unique  // Gizmo username
  firstName       String?
  lastName        String?
  phone          String?
  birthDate       DateTime?
  
  // Account Status
  isActive        Boolean   @default(true)
  isBanned        Boolean   @default(false)
  banReason       String?
  banExpiry       DateTime?
  
  // Financial Info
  currentBalance  Float     @default(0.0)  // Current account balance
  totalDeposits   Float     @default(0.0)  // Lifetime deposits
  totalSpending   Float     @default(0.0)  // Lifetime spending
  creditLimit     Float     @default(0.0)  // Credit limit
  
  // Usage Stats
  totalPlayTime   Int       @default(0)    // Total minutes played
  totalSessions   Int       @default(0)    // Total sessions count
  averageSession  Float     @default(0.0)  // Average session length (minutes)
  lastActiveDate  DateTime? // Last activity date
  
  // Membership
  membershipType  String?   // "VIP", "Premium", "Standard"
  membershipExpiry DateTime?
  loyaltyPoints   Int       @default(0)
  
  // Relations
  sessions        GizmoSession[]
  transactions    GizmoTransaction[]
  activities      GizmoActivity[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([gizmoUserId])
  @@index([isActive])
}

model GizmoSession {
  id          String            @id @default(cuid())
  profileId       String
  profile         GizmoProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  // Session Details
  sessionId       String            @unique  // Gizmo session ID
  computerName    String?           // PC-001, PS5-001, etc.
  zoneName        String?           // "PC Zone", "PS5 Zone", "Cafe"
  
  // Timing
  startTime       DateTime
  endTime         DateTime?
  duration        Int?              // Minutes (calculated when session ends)
  pausedDuration  Int               @default(0)  // Total paused time
  
  status          GizmoSessionStatus @default(ACTIVE)
  
  // Costs
  ratePerMinute   Float             @default(0)
  totalCost       Float             @default(0)
  discountAmount  Float             @default(0)
  finalCost       Float             @default(0)
  
  // Usage Details
  applicationsUsed String[]         // Software/games used
  bandwidth       Float             @default(0)  // MB downloaded
  
  // Relations
  activities      GizmoActivity[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([profileId, startTime])
  @@index([status])
  @@index([computerName])
}

model GizmoTransaction {
  id          String              @id @default(cuid())
  profileId       String
  profile         GizmoProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  // Transaction Details
  transactionId   String              @unique  // Gizmo transaction ID
  type          GizmoTransactionType
  amount          Float
  description     String
  
  // Payment Info
  paymentMethod   String?             // "Cash", "Card", "Online", "Credit"
  referenceNumber String?             // Receipt/reference number
  
  // Product/Service Details
  productName     String?
  productCategory String?             // "Gaming", "Food", "Drinks", "Time"
  quantity        Int                 @default(1)
  unitPrice       Float?
  
  // Status
  isSuccessful    Boolean             @default(true)
  isPending       Boolean             @default(false)
  errorMessage    String?
  
  // Balance Impact
  balanceBefore   Float               @default(0)
  balanceAfter    Float               @default(0)
  
  // Metadata
  operatorName    String?             // Staff member who processed
  locationId      String?             // Cafe location
  ipAddress       String?
  
  createdAt       DateTime            @default(now())
  
  @@index([profileId, createdAt])
  @@index([type, createdAt])
  @@index([isSuccessful])
}

model GizmoActivity {
  id          String            @id @default(cuid())
  profileId       String?
  profile         GizmoProfile?     @relation(fields: [profileId], references: [id], onDelete: Cascade)
