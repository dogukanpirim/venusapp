
generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    // Default output: node_modules/.prisma/client (relative to schema location)
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  
  // Loot Box System
  lootboxBalance        Int     @default(0)
  totalLootboxesOpened  Int     @default(0)

  // Coin / Gamification Currency (Gizmo v3 sync)
  coinBalance           Int     @default(0)  // Internal coin balance
  gizmoUserId           Int?    @unique       // Gizmo v3 numeric user ID

  accounts      Account[]
  sessions      Session[]
  player        Player?   // Gaming profile extension
  reviewedSubmissions ChallengeSubmission[] @relation("AdminReviewer")
  lootboxOpenings LootBoxOpening[]

  // E-commerce Relations
  cartItems     CartItem[]
  orders        Order[]

  // Gamification Relations
  xp                UserXP?
  taskCompletions   TaskCompletion[]
  cards             UserCard[]
  coinTransactions  CoinTransaction[]
  processedEvents   ProcessedEvent[]
  dailyLogins       DailyLogin[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Zone {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  image       String?
  
  // Enhanced Zone Management Fields
  features    String[]  @default([]) // Array of zone features
  capacity    Int       @default(0)  // Number of seats/stations
  equipment   String?   // JSON string for equipment details
  pricePerHour Float    @default(0)  // Base hourly pricing
  specialOffers String? // JSON for special pricing tiers
  
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int?     // minutes for gaming zones
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ============ E-COMMERCE SYSTEM ============

model EcommerceProduct {
  id              String     @id @default(cuid())
  ikasProductId   String?    @unique  // İkas product ID for sync
  name            String
  description     String?
  price           Float
  currency        String     @default("TRY")
  sku             String     @unique
  stock           Int        @default(0)
  images          String[]   @default([])
  brand           String?
  status          String     @default("active") // active, inactive
  
  // Category & Classification
  category        String?    // cpu, gpu, ram, storage, motherboard, psu
  categoryName    String?    // Display name
  
  // Metadata from original hardware
  metadata        String?    // JSON string with original hardware data
  gamingScore     Int?
  
  // Relations
  cartItems       CartItem[]
  orderItems      OrderItem[]
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model CartItem {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         EcommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int              @default(1)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String       @id @default(cuid())
  ikasOrderId     String?      @unique  // İkas order ID for sync
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  
  // Order Details
  orderNumber     String       @unique
  status          OrderStatus  @default(PENDING)
  total           Float
  currency        String       @default("TRY")
  
  // Customer Info
  customerEmail   String
  customerName    String
  customerPhone   String?
  
  // Addresses
  shippingAddress String?      // JSON string
  billingAddress  String?      // JSON string
  
  // Payment & Processing
  paymentMethod   String?
  paymentStatus   String?      @default("pending")
  paidAt          DateTime?
  
  // Shipping
  shippingMethod  String?
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  // Relations
  items           OrderItem[]
  
  // Notes & Metadata
  notes           String?
  metadata        String?      // JSON for additional data
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrderItem {
  id              String           @id @default(cuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         EcommerceProduct @relation(fields: [productId], references: [id])
  
  // Item Details
  productName     String           // Snapshot of product name at order time
  sku             String
  price           Float            // Price at order time
  quantity        Int
  total           Float            // price * quantity
  
  createdAt       DateTime         @default(now())
}

model IkasSync {
  id              String   @id @default(cuid())
  type            String   // 'product', 'order', 'customer'
  localId         String   // Local database ID
  ikasId          String   // İkas ID
  status          String   @default("synced") // synced, pending, error
  lastSyncAt      DateTime @default(now())
  errorMessage    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([type, localId])
  @@unique([type, ikasId])
}

// Tournament System Models

model Player {
  id              String            @id @default(cuid())
  userId          String?           @unique
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamertag        String            @unique
  displayName     String
  email           String?
  phone           String?
  avatar          String?
  bio             String?
  
  // Gaming Stats
  totalPoints     Int               @default(0)
  currentRank     String            @default("Bronze")
  skillRating     Float             @default(1000.0) // TRP equivalent
  totalMatches    Int               @default(0)
  totalWins       Int               @default(0)
  winRate         Float             @default(0.0)
  
  // Gizmo Integration
  gizmoUserId     String?           @unique
  
  
  // Overwolf Integration
  overwolfUserId  String?          @unique  // Overwolf user identifier
  lastActiveGame  String?          // Last played game
  isOnline        Boolean          @default(false) // Real-time online status
  
  // New Arcade Features
  favoriteGame    GameTitle?       // Player's preferred game
  playStyle       String?          // "aggressive", "tactical", "support"
  preferredRole   String?          // "duelist", "controller", "initiator", "sentinel"
  
  // Enhanced Stats
  currentStreak   Int              @default(0)  // Current win/loss streak
  longestStreak   Int              @default(0)  // Longest win streak
  clutchWins      Int              @default(0)  // 1vX clutch wins
  mvpCount        Int              @default(0)  // MVP/POTG count
  
  // Social Features
  title          String?          // Custom title/badge
  showcase       String[]         // Featured achievements/stats
  
  // Relations
  registrations   Registration[]
  results         TournamentResult[]
  stats           PlayerStats[]
  achievements    PlayerAchievement[]
  rewards         PlayerReward[]
  battlePasses    PlayerBattlePass[]
  submissions     ChallengeSubmission[]
  
  // Overwolf Relations
  matches         OverwolfMatch[]  @relation("PlayerMatches")
  challengeProgress ChallengeProgress[] @relation("PlayerChallengeProgress")
  dailyStats      DailyStats[]     @relation("PlayerDailyStats")
  
  // New Arcade Relations
  ranks          PlayerRank[]     @relation("PlayerRanks")
  
  // Gizmo Relations
  gizmoProfile    GizmoProfile?
  
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Game {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique
  description   String?
  image         String?
  category      String       // FPS, MOBA, BR, etc.
  platforms     String[]     // PC, Console, Mobile
  maxPlayers    Int          @default(1)
  isTeamBased   Boolean      @default(false)
  
  tournaments   Tournament[]
  challenges    Challenge[]
  stats         PlayerStats[]
  
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum TournamentStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
  LADDER
}

model Tournament {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  description       String?
  image             String?
  
  gameId            String
  game              Game                @relation(fields: [gameId], references: [id])
  seasonId          String?
  season            Season?             @relation(fields: [seasonId], references: [id])
  
  format            TournamentFormat    @default(SINGLE_ELIMINATION)
  status            TournamentStatus    @default(UPCOMING)
  maxParticipants   Int                 @default(64)
  entryFee          Float               @default(0)
  
  // Prize Pool
  totalPrizePool    Float               @default(0)
  cashPrize         Float               @default(0)
  bonusCredits      Float               @default(0)
  
  // Schedule
  registrationStart DateTime
  registrationEnd   DateTime
  startDate         DateTime
  endDate           DateTime?
  
  // Location
  isOnline          Boolean             @default(false)
  venue             String?
  
  // Skill Requirements
  minRating         Float?
  maxRating         Float?
  requiredRank      String?
  
  // Relations
  registrations     Registration[]
  results           TournamentResult[]
  rewards           Reward[]
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  SPECIAL
}

enum ChallengeCategory {
  AUTO    // Gizmo-based automatic challenges
  MANUAL  // Screenshot-based manual challenges
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

model Challenge {
  id              String            @id @default(cuid())
  title           String
  description     String
  image           String?
  
  gameId          String
  game            Game              @relation(fields: [gameId], references: [id])
  
  type            ChallengeType
  category        ChallengeCategory @default(AUTO)
  difficulty      String            @default("Easy") // Easy, Medium, Hard, Expert
  
  // Requirements
  target          String            // "Win 5 matches", "Get 10 kills", etc.
  targetValue     Int
  currentProgress Int               @default(0)
  
  // Auto Challenge Fields (Gizmo Integration)
  gizmoTrackingKey String?          // Key for Gizmo to track (e.g., "play_time", "spending")
  autoCompleteRule String?          // JSON rule for auto completion
  
  // Manual Challenge Fields  
  submissionInstructions String?    // Instructions for screenshot submission
  exampleImages          String[]   // Example screenshot URLs
  requiredProofCount     Int        @default(1) // How many screenshots needed
  
  // Rewards
  pointsReward    Int               @default(0)
  creditsReward   Float             @default(0)
  
  // Schedule
  startDate       DateTime
  endDate         DateTime
  
  status          ChallengeStatus   @default(ACTIVE)
  
  // Relations
  registrations   Registration[]
  submissions     ChallengeSubmission[]
  
  progress        ChallengeProgress[] @relation("ChallengeProgress")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ChallengeSubmission {
  id              String            @id @default(cuid())
  challengeId     String
  challenge       Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Submission Data
  screenshotUrls  String[]          // Uploaded screenshot URLs
  description     String?           // Optional description from player
  metadata        String?           // JSON metadata (game stats, etc.)
  
  // Admin Review
  status          SubmissionStatus  @default(PENDING)
  reviewedById    String?           // Admin who reviewed
  reviewedBy      User?             @relation("AdminReviewer", fields: [reviewedById], references: [id])
  reviewNotes     String?           // Admin review comments
  reviewedAt      DateTime?
  
  // Auto-completion tracking
  isAutoCompleted Boolean           @default(false)
  autoCompletedAt DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@unique([challengeId, playerId])
}

model Season {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  image           String?
  
  // Season Details
  seasonNumber    Int
  totalPrizePool  Float         @default(0)
  battlePassPrice Float         @default(0)
  
  // Schedule
  startDate       DateTime
  endDate         DateTime
  
  // Relations
  tournaments     Tournament[]
  battlePasses    BattlePass[]
  
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BattlePass {
  id              String              @id @default(cuid())
  seasonId        String
  season          Season              @relation(fields: [seasonId], references: [id])
  
  name            String
  description     String?
  price           Float
  benefits        String[]            // JSON array of benefits
  
  // Guaranteed gaming hours, discounts, etc.
  gamingHours     Int                 @default(0)
  discountPercent Float               @default(0)
  
  players         PlayerBattlePass[]
  
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

model Registration {
  id              String              @id @default(cuid())
  playerId        String
  player          Player              @relation(fields: [playerId], references: [id])
  
  tournamentId    String?
  tournament      Tournament?         @relation(fields: [tournamentId], references: [id])
  challengeId     String?
  challenge       Challenge?          @relation(fields: [challengeId], references: [id])
  
  // Team Info (for team tournaments)
  teamName        String?
  teammates       String[]            // JSON array of teammate playerIds
  isTeamLeader    Boolean             @default(false)
  needsTeam       Boolean             @default(false)
  
  status          RegistrationStatus  @default(PENDING)
  notes           String?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  @@unique([playerId, tournamentId])
  @@unique([playerId, challengeId])
}

model TournamentResult {
  id              String      @id @default(cuid())
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id])
  playerId        String
  player          Player      @relation(fields: [playerId], references: [id])
  
  position        Int         // 1st, 2nd, 3rd, etc.
  score           Float?      // kills, points, etc.
  matchesWon      Int         @default(0)
  matchesLost     Int         @default(0)
  
  // Earnings
  cashEarned      Float       @default(0)
  creditsEarned   Float       @default(0)
  pointsEarned    Int         @default(0)
  
  createdAt       DateTime    @default(now())
  
  @@unique([tournamentId, playerId])
}

model PlayerStats {
  id              String      @id @default(cuid())
  playerId        String
  player          Player      @relation(fields: [playerId], references: [id])
  gameId          String
  game            Game        @relation(fields: [gameId], references: [id])
  
  // General Stats
  gamesPlayed     Int         @default(0)
  wins            Int         @default(0)
  losses          Int         @default(0)
  winRate         Float       @default(0.0)
  
  // Game-specific stats (JSON)
  kills           Int?
  deaths          Int?
  assists         Int?
  kda             Float?
  headshots       Int?
  accuracy        Float?
  
  // Performance metrics
  avgScore        Float       @default(0)
  bestScore       Float       @default(0)
  totalPlayTime   Int         @default(0) // minutes
  
  lastUpdated     DateTime    @updatedAt
  
  @@unique([playerId, gameId])
}

model Achievement {
  id              String              @id @default(cuid())
  name            String              @unique
  description     String
  icon            String?
  category        String              // Tournament, Challenge, Skill, etc.
  difficulty      String              @default("Common") // Common, Rare, Epic, Legendary
  
  // Requirements
  requirements    String              // JSON describing requirements
  pointsReward    Int                 @default(0)
  
  players         PlayerAchievement[]
  
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
}

model PlayerAchievement {
  id              String      @id @default(cuid())
  playerId        String
  player          Player      @relation(fields: [playerId], references: [id])
  achievementId   String
  achievement     Achievement @relation(fields: [achievementId], references: [id])
  
  unlockedAt      DateTime    @default(now())
  
  @@unique([playerId, achievementId])
}

model Reward {
  id              String        @id @default(cuid())
  tournamentId    String?
  tournament      Tournament?   @relation(fields: [tournamentId], references: [id])
  
  name            String
  description     String?
  type            String        // Cash, Credits, Item, etc.
  value           Float
  position        Int?          // 1st place, 2nd place, etc.
  
  players         PlayerReward[]
  
  createdAt       DateTime      @default(now())
}

model PlayerReward {
  id              String    @id @default(cuid())
  playerId        String
  player          Player    @relation(fields: [playerId], references: [id])
  rewardId        String
  reward          Reward    @relation(fields: [rewardId], references: [id])
  
  claimed         Boolean   @default(false)
  claimedAt       DateTime?
  
  createdAt       DateTime  @default(now())
  
  @@unique([playerId, rewardId])
}

model PlayerBattlePass {
  id              String      @id @default(cuid())
  playerId        String
  player          Player      @relation(fields: [playerId], references: [id])
  battlePassId    String
  battlePass      BattlePass  @relation(fields: [battlePassId], references: [id])
  
  purchasedAt     DateTime    @default(now())
  expiresAt       DateTime
  
  // Usage tracking
  hoursUsed       Int         @default(0)
  discountsUsed   Int         @default(0)
  
  isActive        Boolean     @default(true)
  
  @@unique([playerId, battlePassId])
}

// ============ GAMIFICATION SYSTEM ============

model UserXP {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  currentXP       Int       @default(0)
  totalXP         Int       @default(0)
  level           Int       @default(1)
  
  // XP sources tracking
  tasksXP         Int       @default(0)
  gamesXP         Int       @default(0)
  bonusXP         Int       @default(0)
  
  lastUpdated     DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

model GamificationTask {
  id              String            @id @default(cuid())
  title           String
  description     String
  icon            String?           // emoji or icon name
  
  // Task properties
  type            String            @default("daily") // daily, weekly, special
  difficulty      String            @default("easy")  // easy, medium, hard
  category        String            @default("general") // gaming, social, cafe
  
  // Requirements
  target          String            // "play_30_minutes", "spend_50_tl", etc.
  targetValue     Int               @default(1)
  
  // Rewards
  xpReward        Int               @default(10)
  creditsReward   Float             @default(0)
  
  // Schedule
  startDate       DateTime          @default(now())
  endDate         DateTime?         // null for permanent tasks
  
  // Status
  isActive        Boolean           @default(true)
  isRepeatable    Boolean           @default(true)
  
  // Relations
  completions     TaskCompletion[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model TaskCompletion {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String
  task            GamificationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  // Completion details
  progress        Int               @default(0) // current progress
  completed       Boolean           @default(false)
  completedAt     DateTime?
  
  // Rewards claimed
  xpClaimed       Int               @default(0)
  creditsClaimed  Float             @default(0)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@unique([userId, taskId])
}

model Card {
  id              String      @id @default(cuid())
  name            String      @unique
  description     String
  image           String?     // card image URL
  
  // Card properties
  rarity          String      @default("common") // common, rare, epic, legendary
  category        String      @default("general") // food, gaming, meme, special
  
  // Game mechanics
  unlockLevel     Int         @default(1)        // minimum level to unlock
  unlockCost      Int         @default(100)      // XP or credits cost
  
  // Fun attributes for instant ramen style cards
  flavor          String?     // "spicy", "mild", "extra_hot"
  power           Int         @default(1)        // 1-10 power level
  collectible     Boolean     @default(true)
  
  // Relations
  userCards       UserCard[]
  
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model UserCard {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  // Collection details
  quantity        Int       @default(1)
  unlockedAt      DateTime  @default(now())
  isFavorite      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, cardId])
}

// Leaderboard View (computed from PlayerStats and TournamentResults)
model Leaderboard {
  id              String    @id @default(cuid())
  playerId        String
  gameId          String?
  
  // Rankings
  overallRank     Int?
  gameRank        Int?
  skillRating     Float     @default(1000.0)
  totalPoints     Int       @default(0)
  
  // Performance
  tournamentsWon  Int       @default(0)
  totalWinnings   Float     @default(0)
  
  lastUpdated     DateTime  @updatedAt
  
  @@unique([playerId, gameId])
}

// ============ LOOT BOX SYSTEM ============

enum LootBoxRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum LootBoxRewardType {
  FREE_HOURS        // Ücretsiz PC kullanım saatleri
  DRINK_COUPON      // İçecek kuponları
  BATTLEPASS_XP     // BattlePass XP
  TOURNAMENT_ENTRY  // Turnuva katılım hakkı
  CREDITS           // Kredi
  SPECIAL_ITEM      // Özel eşyalar (Avatar, Badge vb.)
}

model LootBoxReward {
  id              String            @id @default(cuid())
  name            String            // "5 Saat Ücretsiz PC", "Kahve Kuponu"
  description     String?           // Detaylı açıklama
  icon            String?           // Ödül ikonu URL'i
  image           String?           // Ödül görseli URL'i
  
  type            LootBoxRewardType
  rarity          LootBoxRarity     @default(COMMON)
  
  // Reward Values
  value           Float             @default(0)    // Hours, credits, etc.
  quantity        Int               @default(1)    // Coupon count, XP amount
  
  // Drop Rate (probability weight)
  weight          Int               @default(100)  // Higher = more common
  
  // Conditions
  minUserLevel    Int?              // Minimum user level required
  requiredBadge   String?           // Required achievement/badge
  
