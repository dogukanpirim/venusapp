// ─── Coin Transaction (Gamification Currency) ─────────────────────────────────
// Tracks every coin earn/spend event for audit and dispute resolution.
// Synced to Gizmo v3 /api/v3.0/pointstransactions when gizmoTransactionId is set.
model CoinTransaction {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transaction type
  type                CoinTxType

  // Amount (always positive — type determines direction)
  amount              Int

  // Running balance after this transaction
  balanceAfter        Int

  // Source that triggered this transaction
  source              String    // "session_duration", "daily_login", "challenge", "streak", "admin", "spend", "lootbox_grant"
  sourceId            String?   // Reference ID (sessionId, challengeId, etc.)
  description         String?

  // Gizmo v3 sync
  gizmoTransactionId  Int?      // ID from /api/v3.0/pointstransactions
  syncedToGizmo       Boolean   @default(false)
  syncedAt            DateTime?

  // Idempotency — prevents double-award
  externalId          String?   @unique  // e.g. "session:abc123:end" or "challenge:xyz:complete"

  createdAt           DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([source, createdAt])
  @@index([syncedToGizmo])
}

enum CoinTxType {
  EARN    // User earned coins
  SPEND   // User spent coins (reward redemption)
  EXPIRE  // Coins expired
  ADJUST  // Admin adjustment
  REFUND  // Refund after dispute
}

// ─── Processed Events (Generic Idempotency) ───────────────────────────────────
// Every dispatched event is recorded here with a unique externalId.
// Prevents double-awards from poller retries, network glitches, or double-clicks.
//
// externalId format: "<source>:<entityId>:<phase>"
//   "gizmo_session:1001:start"     — first time we see Gizmo session 1001
//   "gizmo_session:1001:hour:2"    — 2nd hour milestone for session 1001
//   "gizmo_session:1001:end"       — session 1001 ended
//   "daily_login:cuid:2026-04-25"  — daily bonus for user on a date
//   "spend:invoice:5544"           — coin reward for Gizmo invoice 5544
//   "challenge:abc:complete"       — challenge abc completed by player
model ProcessedEvent {
  id           String    @id @default(cuid())
  externalId   String    @unique
  eventType    String    // EventType enum value as string
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What was the result?
  xpAwarded         Int   @default(0)
  coinAwarded       Int   @default(0)
  lootboxesGranted  Int   @default(0)

  // Audit
  payload      String?   // JSON snapshot of payload at process time
  result       String?   // JSON snapshot of handler results
  errorMessage String?   // populated only if dispatcher partially failed

  processedAt  DateTime  @default(now())

  @@index([userId, processedAt])
  @@index([eventType, processedAt])
}

// ─── Daily Login (Streak Tracking) ────────────────────────────────────────────
// One row per user per day they came to the cafe.
// Created lazily by the dispatcher when the first session of the day is detected.
//
// `streakAtLogin`: how many consecutive days they've come, INCLUDING today.
// Resets to 1 when there's a gap > 1 day.
model DailyLogin {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date            // calendar day (no time component)
  streakAtLogin   Int      @default(1)         // consecutive day count

  // Source session that triggered the login
  gizmoSessionId  String?                       // local GizmoSession.id (cuid)
  gizmoUserId     Int?
  hostId          Int?

  // Rewards summary for this login
  coinAwarded     Int      @default(0)         // base + streak bonus
  lootboxAwarded  Boolean  @default(false)     // milestone lootboxes

  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}
