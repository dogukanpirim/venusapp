}

enum GizmoTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADJUSTMENT
  TIME_PURCHASE
  PRODUCT_PURCHASE
  SERVICE_FEE
}

enum GizmoSessionStatus {
